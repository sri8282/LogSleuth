# ==============================================================================
# LogSleuth AI Backend Environment Configuration Template
# Copy this file to '.env' and fill in the values for local development.
# NEVER commit the active '.env' file or expose live credentials.
# ==============================================================================

# Server configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security / CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Gemini API Configuration (Placeholder)
# Required for future LLM log investigation and evaluation stages
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
